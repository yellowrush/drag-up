{
  "name": "drag-up",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "sync:version": "node scripts/sync-app-version.js",
    "predev:h5": "npm run sync:version",
    "prebuild:h5": "npm run sync:version",
    "predev:mp-weixin": "npm run sync:version",
    "prebuild:mp-weixin": "npm run sync:version",
    "predev:minigame": "npm run sync:version",
    "prebuild:minigame": "npm run sync:version",
    "predev": "npm run sync:version",
    "predeploy:mp-weixin": "npm run sync:version",
    "dev": "node dev-minigame.js",
    "dev:h5": "uni --platform h5",
    "build:h5": "uni build --platform h5",
    "dev:mp-weixin": "uni --platform mp-weixin",
    "build:mp-weixin": "uni build --platform mp-weixin",
    "dev:minigame": "node dev-minigame.js",
    "build:minigame": "node build-minigame.js",
    "upload:mp-weixin": "node upload.js",
    "upload:minigame": "node upload.js minigame",
    "upload:minigame:ci": "node ci-upload.js minigame",
    "deploy:cloudfunctions": "node deploy-cloudfunctions-minigame.js",
    "deploy:cloudfunctions:cloudbase": "npx --package @cloudbase/cli cloudbase --config-file cloudbaserc.json fn deploy --all --force",
    "deploy:mp-weixin": "uni build --platform mp-weixin && node upload.js"
  },
  "dependencies": {
    "@vue/shared": "3.5.13",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-components": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5010320260611001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5010320260611001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5010320260611001",
    "miniprogram-ci": "^2.1.31",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "overrides": {
    "@vue/shared": "3.5.13"
  }
}
